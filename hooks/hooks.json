{
  "description": "model-router hooks: inject the routing rules at session start, resume, clear, compact and fork (or on the next prompt if the session was already open), give every subagent launch its tier's model and block session forks, hand the plugin's agents their working directory, branch and scratchpad at start, keep the operators from writing files through the shell, tell the user when /compact would pay off, nudge the main session to delegate after a run of command/MCP calls, and send an over-long subagent report back for a summary.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\" rules || python \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\" rules || true"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\" corrections || python \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\" corrections || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ensure-rules.py\" rules || python \"${CLAUDE_PLUGIN_ROOT}/hooks/ensure-rules.py\" rules || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ensure-rules.py\" corrections || python \"${CLAUDE_PLUGIN_ROOT}/hooks/ensure-rules.py\" corrections || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/context-watch.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/context-watch.py\" || true",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ops-nudge.py\" reset || python \"${CLAUDE_PLUGIN_ROOT}/hooks/ops-nudge.py\" reset || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-model.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-model.py\" || true",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-writes.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-writes.py\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ops-nudge.py\" count || python \"${CLAUDE_PLUGIN_ROOT}/hooks/ops-nudge.py\" count || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-context.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-context.py\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/report-budget.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/report-budget.py\" || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
